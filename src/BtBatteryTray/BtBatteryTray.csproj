<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <Version>1.2.2</Version>
    <Product>BT Battery Tray</Product>
    <AssemblyTitle>BT Battery Tray</AssemblyTitle>
    <Description>Niveau de batterie des appareils Bluetooth dans la barre des tâches</Description>
    <Authors>Bechir Zalila</Authors>
    <Copyright>Copyright (c) 2026 Bechir Zalila</Copyright>
  </PropertyGroup>

  <!-- Publication : un seul exe, utilisant le runtime .NET 8 déjà installé sur le PC. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
